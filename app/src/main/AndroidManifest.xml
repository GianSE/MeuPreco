<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeuPreco">

        <!-- Activity principal (Launcher): lista de preços gravados no banco. -->
        <activity
            android:name=".ListaPrecosActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cadastro/edição de preço (entidade Produto). Aberta pela lista
             esperando um resultado.
             parentActivityName declara a Lista como tela pai (botão Up). -->
        <activity
            android:name=".CadastroPrecoActivity"
            android:exported="false"
            android:label="@string/titulo_activity_cadastro"
            android:parentActivityName=".ListaPrecosActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity de Autoria (Entrega 3). Aberta pela lista pelo botão "Sobre". -->
        <activity
            android:name=".AutoriaActivity"
            android:exported="false"
            android:label="@string/titulo_autoria"
            android:parentActivityName=".ListaPrecosActivity" />

        <!-- Activity de Configurações (Entrega 5). Aberta pelo menu da lista. -->
        <activity
            android:name=".ConfiguracoesActivity"
            android:exported="false"
            android:label="@string/titulo_configuracoes"
            android:parentActivityName=".ListaPrecosActivity" />

        <!-- Lista de mercados (Entrega Final). Aberta pelo menu da lista de preços. -->
        <activity
            android:name=".ListaMercadosActivity"
            android:exported="false"
            android:label="@string/titulo_mercados"
            android:parentActivityName=".ListaPrecosActivity" />

        <!-- Cadastro/edição de mercado (entidade Mercado). Tela pai: lista de mercados. -->
        <activity
            android:name=".CadastroMercadoActivity"
            android:exported="false"
            android:label="@string/titulo_cadastro_mercado"
            android:parentActivityName=".ListaMercadosActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
