    <!-- About -->
    <string name="titulo_autoria">About the app</string>
    <string name="autoria_descricao">Meu Preço is an app for personal recording of product prices at markets. You register the markets where you shop and, for each purchase, the product, brand, category, unit, price and purchase date. Everything is saved in a database on the device, so you can compare prices over time.</string>
