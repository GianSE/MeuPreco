<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela de cadastro de um registro de preco.
    A raiz e um LinearLayout vertical: em cima fica a faixa verde (barra de
    titulo do app) e embaixo o ScrollView com o formulario, que pode ser
    rolado em telas pequenas (testado no perfil Nexus 4).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===================== Barra do Aplicativo (Toolbar) ===================== -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_500"
        android:minHeight="?attr/actionBarSize"
        app:titleTextColor="@color/branco" />

    <ScrollView
        android:id="@+id/scrollFormulario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cabecalho"
            android:textColor="@color/verde_700"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitulo"
            android:textColor="@color/cinza_texto"
            android:textSize="14sp" />

        <!-- ===================== Nome do produto ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_produto" />

        <EditText
            android:id="@+id/editProduto"
            style="@style/CampoTexto"
            android:hint="@string/hint_produto"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <!-- ===================== Marca ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_marca" />

        <EditText
            android:id="@+id/editMarca"
            style="@style/CampoTexto"
            android:hint="@string/hint_marca"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <!-- ===================== Mercado ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_mercado" />

        <EditText
            android:id="@+id/editMercado"
            style="@style/CampoTexto"
            android:hint="@string/hint_mercado"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <!-- ===================== Preco e quantidade ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="8dp"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/RotuloCampo"
                    android:text="@string/label_preco" />

                <EditText
                    android:id="@+id/editPreco"
                    style="@style/CampoTexto"
                    android:digits="0123456789.,"
                    android:hint="@string/hint_preco"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RotuloCampo"
                    android:text="@string/label_quantidade" />

                <EditText
                    android:id="@+id/editQuantidade"
                    style="@style/CampoTexto"
                    android:digits="0123456789.,"
                    android:hint="@string/hint_quantidade"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== Spinner de categoria ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_categoria" />

        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- ===================== RadioGroup: unidade de medida ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_unidade" />

        <RadioGroup
            android:id="@+id/grupoUnidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioUnidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_unidade" />

            <RadioButton
                android:id="@+id/radioQuilo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:text="@string/rb_quilo" />

            <RadioButton
                android:id="@+id/radioLitro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:text="@string/rb_litro" />
        </RadioGroup>

        <!-- ===================== RadioGroup: forma de pagamento ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_pagamento" />

        <RadioGroup
            android:id="@+id/grupoPagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioDinheiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_dinheiro" />

            <RadioButton
                android:id="@+id/radioCartao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_cartao" />

            <RadioButton
                android:id="@+id/radioPix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_pix" />
        </RadioGroup>

        <!-- ===================== CheckBox ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_opcoes" />

        <CheckBox
            android:id="@+id/checkPromocao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_promocao" />

        <CheckBox
            android:id="@+id/checkFavorito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_favorito" />

        <CheckBox
            android:id="@+id/checkLembrete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_lembrete" />

        <!-- ===================== Observacoes ===================== -->
        <TextView
            style="@style/RotuloCampo"
            android:text="@string/label_observacoes" />

        <EditText
            android:id="@+id/editObservacoes"
            style="@style/CampoTexto"
            android:gravity="top|start"
            android:hint="@string/hint_observacoes"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:lines="3" />

        <!-- ===================== Botoes ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botaoSalvar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bt_salvar" />

            <Button
                android:id="@+id/botaoLimpar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/bt_limpar" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
