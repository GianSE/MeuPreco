<?xml version="1.0" encoding="utf-8"?>
<!--
    Lista de mercados (Entrega Final).
    Barra do Aplicativo (Toolbar) no topo e a ListView (com empty view)
    ocupando o restante da tela, preenchida com a tabela mercados do banco.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_500"
        android:minHeight="?attr/actionBarSize"
        app:subtitleTextColor="@color/verde_200"
        app:titleTextColor="@color/branco" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listaMercados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/cinza_divisor"
            android:dividerHeight="1dp"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/textVazio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/lista_mercados_vazia"
            android:textColor="@color/cinza_texto"
            android:textSize="16sp" />
    </FrameLayout>

</LinearLayout>
