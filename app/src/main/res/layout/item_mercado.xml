<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de uma linha da lista de mercados (usado pelo MercadoAdapter).
    Mostra o nome, a cidade e quantos precos foram registrados no mercado.
    O fundo destaca a linha selecionada no Menu de Acao Contextual.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_item_lista"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:layout_marginRight="12dp"
        android:background="@color/verde_500"
        android:contentDescription="@string/menu_mercados"
        android:padding="8dp"
        android:src="@drawable/ic_store" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textNomeMercado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/verde_700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cinza_texto"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:gravity="end"
        android:textColor="@color/laranja_500"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
