<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela principal (Launcher) - Entrega 3.
    Barra do Aplicativo (Toolbar) no topo; abaixo os botões Adicionar/Sobre;
    e a ListView (com empty view) ocupando o restante da tela.
    A lista agora e preenchida pelos cadastros feitos na tela de Cadastro.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_500"
        android:minHeight="?attr/actionBarSize"
        app:subtitleTextColor="@color/verde_200"
        app:titleTextColor="@color/branco" />

    <!-- ===================== Lista (com empty view) =====================
         As ações Adicionar/Sobre agora ficam no menu de opções (Entrega 4). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listaProdutos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/cinza_divisor"
            android:dividerHeight="1dp"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/textVazio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/lista_vazia"
            android:textColor="@color/cinza_texto"
            android:textSize="16sp" />
    </FrameLayout>

</LinearLayout>
